# Build settings. Copy to .env (not committed) or set them in the host's build environment.
# All are optional: without them the site builds and works, as described next to each.

# The address the site is served from. Canonical links, link previews (og:image, og:url), the
# sitemap and robots.txt use it. Without it they point at https://fourteen-peaks.example.
SITE_URL=https://example.com

# Visit counting, cookieless: plausible or umami. Off (and no consent card) unless all three are set.
# VITE_ANALYTICS=plausible
# VITE_ANALYTICS_SRC=https://plausible.io/js/script.js
# VITE_ANALYTICS_SITE=example.com
# (umami: VITE_ANALYTICS_SRC=https://cloud.umami.is/script.js and VITE_ANALYTICS_SITE=<website id>)

# Where "Suggest a correction" posts its JSON (Formspree, Web3Forms, a Worker …). Without it the
# form opens a prefilled issue in the public GitHub repository instead.
# VITE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
